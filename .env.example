# --- QAuto API (server side) ---
QAUTO_BASE_URL=https://qauto.forstudy.space/api
QAUTO_TIMEOUT=30

# --- Credentials: fallback only. The MCP client normally sends them in headers. ---
QAUTO_EMAIL=
QAUTO_PASSWORD=

# --- MCP transport ---
# streamable-http (default) or stdio
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
# Framework / transport logs: DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_LOG_LEVEL=INFO

# --- Application logs (tools + HTTP calls to QAuto), stderr, secrets masked ---
LOG_LEVEL=INFO
# Request/response bodies, visible only with LOG_LEVEL=DEBUG
LOG_HTTP_BODIES=true
LOG_BODY_MAX_CHARS=2000
